# --- Shared ---
DATABASE_URL=postgresql://truewell:changeme@localhost:5432/truewell
REDIS_URL=redis://localhost:6379/0

# --- Web (apps/web) ---
TRUEWELL_API_URL=http://localhost:8000
SESSION_COOKIE_NAME=tw_session
REFRESH_COOKIE_NAME=tw_refresh
NEXT_PUBLIC_APP_NAME=Truewell
NEXT_PUBLIC_SUPPORT_EMAIL=support@truewell.example

# --- API (services/api) ---
TRUEWELL_ENVIRONMENT=development
TRUEWELL_DATABASE_URL=postgresql+psycopg://truewell:changeme@localhost:5432/truewell
TRUEWELL_REDIS_URL=redis://localhost:6379/0
TRUEWELL_JWT_SECRET=dev-only-secret-change-me
TRUEWELL_ACCESS_TOKEN_MINUTES=15
TRUEWELL_REFRESH_TOKEN_DAYS=14
TRUEWELL_VIDEO_PROVIDER_URL=https://video.truewell.example
TRUEWELL_VIDEO_SIGNING_KEY=dev-video-key-change-me
TRUEWELL_NOTIFIER_URL=http://localhost:8090
TRUEWELL_REMINDER_LEAD_HOURS=24
TRUEWELL_LAB_RELEASE_DELAY_HOURS=12

# --- Notifier (services/notifier) ---
NOTIFIER_ADDR=:8090
NOTIFIER_API_TOKEN=change-me
NOTIFIER_MAX_PER_MINUTE=60
NOTIFIER_QUIET_START=21
NOTIFIER_QUIET_END=7
NOTIFIER_QUIET_TZ=America/New_York

# --- Worker (apps/worker) ---
WORKER_CONCURRENCY=4
SESSION_RETENTION_DAYS=30
